Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildHMatrix", "[", 
    RowBox[{"elems_", ",", "t_", ",", "b_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"delta", ",", "rows", ",", "gfPower"}], "}"}], ",", 
     RowBox[{
      RowBox[{"delta", "=", 
       RowBox[{
        RowBox[{"2", "*", "t"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"delta", "-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gfPower", "[", "k_", "]"}], ":=", 
       RowBox[{"elems", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "n"}], "]"}], "+", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"gfPower", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", "r", "-", "1"}], ")"}], "*", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "1", ",", "rows"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
