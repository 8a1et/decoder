Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SyndromeNorm", "[", 
    RowBox[{"sPolys_List", ",", "modulus_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nPower", ",", "norm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nPower", "=", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Length", "[", "sPolys", "]"}], "-", "1"}]}], "]"}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"norm", "=", 
       RowBox[{"Fold", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"acc", ",", "pair"}], "}"}], ",", 
           RowBox[{"PolynomialMod", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"acc", "*", 
               RowBox[{"PolynomialMod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"pair", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "^", 
                  RowBox[{"pair", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", "modulus", ",", 
                 RowBox[{"Modulus", "->", "2"}]}], "]"}]}], "]"}], ",", 
             "modulus", ",", 
             RowBox[{"Modulus", "->", "2"}]}], "]"}]}], "]"}], ",", "1", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"sPolys", ",", "nPower"}], "}"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "norm"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9611383020238533`*^9, 3.961138333319803*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"ab1486ba-4591-4b44-93a4-ffb150f12636"]
}, Open  ]],

