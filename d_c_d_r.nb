Cell[BoxData[
 RowBox[{
  RowBox[{"FindErrorPositions", "[", 
   RowBox[{"norm_", ",", "elems_", ",", "modulus_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "elems", "]"}]}], ",", "normOrbit", ",", 
      RowBox[{"found", "=", "False"}], ",", 
      RowBox[{"pos1", "=", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{"pos2", "=", 
       RowBox[{"-", "1"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"normOrbit", "=", 
      RowBox[{"NestList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"PolynomialMod", "[", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"#", "^", "2"}], "]"}], ",", "modulus", ",", 
           RowBox[{"Modulus", "->", "2"}]}], "]"}], "&"}], ",", "norm", ",", 
        RowBox[{"m", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"normOrbit", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Expand", "/@", "normOrbit"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"prod", ",", "orbit"}], "}"}], ",", 
         RowBox[{
          RowBox[{"prod", "=", 
           RowBox[{"PolynomialMod", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{"elems", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
               RowBox[{"elems", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
             "modulus", ",", 
             RowBox[{"Modulus", "->", "2"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"orbit", "=", 
           RowBox[{"NestList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"PolynomialMod", "[", 
               RowBox[{
                RowBox[{"Expand", "[", 
                 RowBox[{"#", "^", "2"}], "]"}], ",", "modulus", ",", 
                RowBox[{"Modulus", "->", "2"}]}], "]"}], "&"}], ",", "prod", ",", 
             RowBox[{"m", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"orbit", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"Expand", "/@", "orbit"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"orbit", "==", "normOrbit"}], ",", 
            RowBox[{
             RowBox[{"pos1", "=", "i"}], ";", 
             RowBox[{"pos2", "=", "j"}], ";", 
             RowBox[{"found", "=", "True"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", 
              RowBox[{"{", 
               RowBox[{"True", ",", "pos1", ",", "pos2"}], "}"}], "]"}], 
             ";"}]}], "]"}], ";"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"n", "-", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "+", "1"}], ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"False", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9611739514373436`*^9, 3.9611739583668003`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"83b6eec5-eb4e-164d-bded-9a9c017a222a"]
}, Open  ]],

