Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SyndromePolynomials", "[", 
    RowBox[{"syndrome_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sBits", ",", "bitsToPoly"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sBits", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", "syndrome", "]"}], ",", "m"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bitsToPoly", "[", "bits_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bits", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", 
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "bits", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bitsToPoly", "/@", "sBits"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9611383020238533`*^9, 3.9611383307043114`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"d5dd9118-a10f-a245-83d3-d26ff453b8db"]
}, Open  ]],

