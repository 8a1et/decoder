Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RunBCHDecoder", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", "11"}], ",", 
       RowBox[{"t", "=", "2"}], ",", 
       RowBox[{"b", "=", "1"}], ",", "modulus", ",", "n", ",", "elems", ",", 
       "H", ",", "HbitMatrix", ",", "Gfull", ",", "G", ",", "k", ",", 
       "message", ",", "codeword", ",", "errorPositions", ",", 
       "receivedBeforeCorrection", ",", "syndrome", ",", "sPolys", ",", 
       "norm", ",", "result", ",", "found", ",", "pos1", ",", "pos2", ",", 
       "received", ",", "numErrors"}], "}"}], ",", 
     RowBox[{
      RowBox[{"modulus", "=", 
       RowBox[{
        RowBox[{"x", "^", "m"}], "+", 
        RowBox[{"x", "^", "2"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "89"}], ";", "\[IndentingNewLine]", 
      RowBox[{"elems", "=", 
       RowBox[{"GenerateField", "[", 
        RowBox[{"m", ",", "modulus"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"H", "=", 
       RowBox[{"BuildHMatrix", "[", 
        RowBox[{"elems", ",", "t", ",", "b", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"HbitMatrix", "=", 
       RowBox[{"HtoBitMatrix", "[", 
        RowBox[{"H", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\:2705 \:0420\:0430\:0437\:043c\:0435\:0440 HbitMatrix: \
\>\"", ",", 
        RowBox[{"Dimensions", "[", "HbitMatrix", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Gfull", "=", 
       RowBox[{"NullSpace", "[", 
        RowBox[{"HbitMatrix", ",", 
         RowBox[{"Modulus", "->", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{"MatrixRank", "[", 
        RowBox[{"HbitMatrix", ",", 
         RowBox[{"Modulus", "->", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"G", "=", 
       RowBox[{"Take", "[", 
        RowBox[{"Gfull", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"message", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "k"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"codeword", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"message", ".", "G"}], ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\|01f4cf \:0414\:043b\:0438\:043d\:0430 \
\:0441\:043e\:043e\:0431\:0449\:0435\:043d\:0438\:044f message: \>\"", ",", 
        RowBox[{"Length", "[", "message", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\|01f4cf \:0414\:043b\:0438\:043d\:0430 codeword: \>\"", ",", 
        RowBox[{"Length", "[", "codeword", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"errorPositions", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"Range", "[", "n", "]"}], ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"receivedBeforeCorrection", "=", "codeword"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"receivedBeforeCorrection", "[", 
        RowBox[{"[", "errorPositions", "]"}], "]"}], "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"receivedBeforeCorrection", "[", 
           RowBox[{"[", "errorPositions", "]"}], "]"}], "+", "1"}], ",", 
         "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\|01f50d \:041e\:0448\:0438\:0431\:043a\:0438 \
\:0432\:043d\:0435\:0441\:0435\:043d\:044b \:0432 \:043f\:043e\:0437\:0438\
\:0446\:0438\:0438: \>\"", ",", "errorPositions"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\|01f4e5 \:0421\:043e\:043e\:0431\:0449\:0435\:043d\:0438\
\:0435 \:0441 \:043e\:0448\:0438\:0431\:043a\:0430\:043c\:0438 (89 \:0431\
\:0438\:0442): \>\"", ",", "receivedBeforeCorrection"}], "]"}], ";", 
