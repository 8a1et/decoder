Cell[BoxData[
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"acc", ",", "pair"}], "}"}], ",", 
       RowBox[{"PolynomialMod", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"acc", "*", 
           RowBox[{"PolynomialMod", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"pair", "[", 
