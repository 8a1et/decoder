Cell[BoxData[
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"!", "foundGoodPair"}], ",", 
    RowBox[{
     RowBox[{"posPair", "=", 
      RowBox[{"RandomSample", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"err1", "=", 
      RowBox[{"elems", "[", 
       RowBox[{"[", 
        RowBox[{"posPair", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"err2", "=", 
      RowBox[{"elems", "[", 
       RowBox[{"[", 
        RowBox[{"posPair", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prod", "=", 
      RowBox[{"PolynomialMod", "[", 
       RowBox[{
        RowBox[{"Expand", "[", 
         RowBox[{"err1", "*", "err2"}], "]"}], ",", "modulus", ",", 
        RowBox[{"Modulus", "->", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"prodVec", "=", 
      RowBox[{"PadRight", "[", 
       RowBox[{
        RowBox[{"CoefficientList", "[", 
         RowBox[{"prod", ",", "x"}], "]"}], ",", "m"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"orbitVecs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"CoefficientList", "[", 
           RowBox[{"#", ",", "x"}], "]"}], ",", "m"}], "]"}], "&"}], "/@", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PolynomialMod", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{"#", "^", "2"}], "]"}], ",", "modulus", ",", 
            RowBox[{"Modulus", "->", "2"}]}], "]"}], "&"}], ",", "prod", ",", 
         RowBox[{"m", "-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"orbitVecs", ",", "prodVec"}], "]"}], ",", 
       RowBox[{
        RowBox[{"errorPositions", "=", "posPair"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"received", "[", 
          RowBox[{"[", "errorPositions", "]"}], "]"}], "=", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"received", "[", 
             RowBox[{"[", "errorPositions", "]"}], "]"}], "+", "1"}], ",", 
           "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"receivedBeforeCorrection", "=", "received"}], ";", 
        RowBox[{"foundGoodPair", "=", "True"}], ";"}]}], "]"}], ";"}]}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9610833903126945`*^9, 3.9610834162387257`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"b3ee6e22-7692-b44d-95e8-b7ce9025ceb0"],

